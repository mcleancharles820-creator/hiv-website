# Set these in Vercel Project Settings > Environment Variables.
# Use a Supabase PostgreSQL connection string with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Generate a unique 32+ character random value. Never commit a real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Resend API key and a sender address/domain verified in Resend.
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM=HIVeLink <notifications@example.com>
# Optional canonical HTTPS origin used in account-verification links.
APP_URL=https://your-domain.example
# Set this in local development only when running the API through Vercel CLI.
REACT_APP_USE_API=true
