# Set these in Vercel Project Settings > Environment Variables.
# Use a Supabase PostgreSQL connection string with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Generate a unique 32+ character random value. Never commit a real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set this in local development only when running the API through Vercel CLI.
REACT_APP_USE_API=true
