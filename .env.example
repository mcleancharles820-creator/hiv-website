# Set these in Vercel Project Settings > Environment Variables.
# Use a Supabase PostgreSQL connection string with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Public build-time credentials for RLS-protected Realtime subscriptions.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public build-time values used only to open RLS-protected Realtime subscriptions.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key
# Generate a unique 32+ character random value. Never commit a real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional only for arbitrary admin/event emails. Supabase Auth sends verification emails itself.
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM=HIVeLink <notifications@example.com>
# Canonical HTTPS origin used in Supabase Auth confirmation redirects.
APP_URL=https://your-domain.example
# Set this in local development only when running the API through Vercel CLI.
REACT_APP_USE_API=true
